# Скопируйте в server/.env и заполните реальными значениями.

# Порт, на котором слушает Express-бэкенд
PORT=4000

# Публичный адрес БЭКЕНДА — именно на него Steam должен присылать callback
# после входа. Для локальной разработки за Vite dev-сервером (проксирующим
# /auth и /api на бэкенд) это будет адрес фронтенда:
PUBLIC_BASE_URL=http://localhost:5173

# Адрес фронтенда, куда бэкенд редиректит пользователя после успешного/
# неуспешного входа через Steam
FRONTEND_URL=http://localhost:5173

# Секрет для подписи сессионных JWT. Сгенерировать: `openssl rand -hex 32`
# Обязателен в production — без него сервер не запустится.
SESSION_SECRET=

# Steam Web API key — бесплатно на https://steamcommunity.com/dev/apikey
# Без него вход через Steam всё равно работает, но никнейм/аватар
# подтягиваются из публичного XML-профиля (менее надёжный резервный путь).
STEAM_API_KEY=

# Путь к файлу SQLite (по умолчанию server/data/pandemia.db)
# DB_PATH=./data/pandemia.db
